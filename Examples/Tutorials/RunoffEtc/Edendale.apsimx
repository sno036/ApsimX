                {
                  "$type": "Models.Soils.Soil, Models",
                  "RecordNumber": 1245,
                  "ASCOrder": null,
                  "ASCSubOrder": null,
                  "SoilType": "Silt loam",
                  "LocalName": "Crookston",
                  "Site": "Byars Rd (from discussion with Ross Monaghan, this is the best soil to start with, Silt loam (Waikaka No1333)",
                  "NearestTown": "Waikaka",
                  "Region": "Southland",
                  "State": null,
