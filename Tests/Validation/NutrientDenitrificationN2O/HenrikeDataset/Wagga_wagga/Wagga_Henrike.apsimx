{
  "$type": "Models.Core.Simulations, Models",
  "Version": 191,
  "Name": "Simulations",
  "ResourceName": null,
  "Children": [
    {
      "$type": "Models.Core.Folder, Models",
      "ShowInDocs": false,
      "GraphsPerPage": 6,
      "Name": "Replacements",
      "ResourceName": null,
      "Children": [
        {
          "$type": "Models.Soils.Nutrients.NFlow, Models",
          "SourceName": "NO3",
          "DestinationName": null,
          "Name": "Denitrification",
          "ResourceName": null,
          "Children": [
            {
              "$type": "Models.Memo, Models",
              "Text": "Denitrification is simulated using the approaches initially used in CERES Maize ([jones_ceres-maize:_1986]) as implemented in APSIM SoilN ([probert_apsims_1998]).  These were based upon the work of [Rolston1984].  Denitrification rate is calculated using this approach to account for the effect of soil carbon, temperature and water on the fraction of nitrate lost on a daily basis.  ",
              "Name": "Memo",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Functions.Constant, Models",
              "FixedValue": 1.0,
              "Units": null,
              "Name": "NLoss",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Functions.ExpressionFunction, Models",
              "Expression": "[Potential] * [CERESDenitrificationTemperatureFactor] * [CERESDenitrificationWaterFactor]",
              "Name": "Rate",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Functions.BoundFunction, Models",
                  "Name": "CERESDenitrificationTemperatureFactor",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 0.0,
                      "Units": null,
                      "Name": "Lower",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 1.0,
                      "Units": null,
                      "Name": "Upper",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.ExpressionFunction, Models",
                      "Expression": "0.1 * exp(0.046 * [Temperature].Value)",
                      "Name": "TemperatureFactor",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.BoundFunction, Models",
                  "Name": "CERESDenitrificationWaterFactor",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 0.0,
                      "Units": null,
                      "Name": "Lower",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 1.0,
                      "Units": null,
                      "Name": "Upper",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.ExpressionFunction, Models",
                      "Expression": "(([SoilWater].SW) - (0.975*[Physical].SAT)) / ([Physical].SAT - (0.975*[Physical].SAT))",
                      "Name": "WaterFactor",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 0.0006,
                  "Units": null,
                  "Name": "DenitrificationRateModifier",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.LessThanFunction, Models",
                  "Name": "ActiveC",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 1.0,
                      "Units": null,
                      "Name": "IsInertActive",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 0.5,
                      "Units": null,
                      "Name": "Comparision",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.ExpressionFunction, Models",
                      "Expression": "[Humic].C + [FOMCarbohydrate].C + [FOMCellulose].C + [FOMLignin].C",
                      "Name": "InertNotActive",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.ExpressionFunction, Models",
                      "Expression": "[Humic].C + [Inert].C + [FOMCarbohydrate].C + [FOMCellulose].C + [FOMLignin].C",
                      "Name": "InertActive",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Expression": "[ActiveC] / ([Physical].BD * [Physical].Thickness / 100)",
                  "Name": "ActiveCppm",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Expression": "0.0031 * [ActiveCppm] + 24.5",
                  "Name": "CarbonModifier",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Expression": "[DenitrificationRateModifier] * [CarbonModifier]",
                  "Name": "Potential",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                }
              ],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Functions.DayCentN2OFractionModel, Models",
              "N2ODiffusionCoefficient": 25.1,
              "Name": "N2OFraction",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "The emission of N2O during denitrification is calculated from an N2:N2O ratio using the approach from the DayCent model ([PARTON1998]) as previously tested in APSIM ([THORBURN2010]).",
                  "Name": "Memo",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                }
              ],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Functions.Constant, Models",
              "FixedValue": 1.0,
              "Units": null,
              "Name": "Reduction",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            }
          ],
          "Enabled": true,
          "ReadOnly": false
        }
      ],
      "Enabled": true,
      "ReadOnly": false
    },
